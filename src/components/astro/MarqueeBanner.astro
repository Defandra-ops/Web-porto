---
interface Props {
  items?: string[];
  label?: string;
}

const { items = ["Frontend Architecture", "Backend & API", "IT Infrastructure"], label = "Area fokus" } = Astro.props;
const ticker = [...items, ...items];
---

<div
  class="marquee-wrapper"
  aria-label={`${label}: ${items.join(", ")}`}
  data-i18n-aria-label-en={`${label === "Keahlian" ? "Expertise" : "Focus areas"}: ${items.join(", ")}`}
  data-i18n-aria-label-ja={`${label === "Keahlian" ? "専門分野" : "注力分野"}: ${items.join(", ")}`}
>
  <div class="marquee-track" aria-hidden="true">
    {ticker.map((item) => (
      <span class="marquee-item">{item}<span class="marquee-star">✳</span></span>
    ))}
  </div>
</div>
