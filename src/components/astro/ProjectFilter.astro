---
import type { ProjectTranslation } from "../../data/projectTranslations";

interface Project {
  title: string;
  excerpt: string;
  category: string;
  role: string;
  stack: string[];
  slug: string;
  example: boolean;
  demoUrl?: string;
  repoUrl?: string;
  designUrl?: string;
  screenshots: { src: string; alt: string }[];
  translations: Record<"en" | "ja", ProjectTranslation>;
}

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
const filters = [
  { id: "Semua", label: "Semua", en: "All", ja: "すべて" },
  { id: "Fullstack", label: "Fullstack", en: "Fullstack", ja: "フルスタック" },
  { id: "Mobile", label: "Mobile", en: "Mobile", ja: "モバイル" },
  { id: "IT Support", label: "IT Support", en: "IT Support", ja: "ITサポート" },
  { id: "UI/UX", label: "UI/UX", en: "UI/UX", ja: "UI/UX" },
];
---

<div class="project-browser" data-project-browser>
  <div class="project-filters" role="group" aria-label="Filter proyek berdasarkan kategori" data-i18n-aria-label-en="Filter projects by category" data-i18n-aria-label-ja="カテゴリーでプロジェクトを絞り込む">
    {filters.map((filter) => (
      <button
        class:list={["filter-button", { "is-selected": filter.id === "Semua" }]}
        type="button"
        aria-pressed={filter.id === "Semua" ? "true" : "false"}
        data-project-filter={filter.id}
      >
        <span data-i18n-en={filter.en} data-i18n-ja={filter.ja}>{filter.label}</span>
        {filter.id === "Semua" && <span class="filter-count">{projects.length}</span>}
      </button>
    ))}
  </div>
  <p class="sr-only" aria-live="polite" data-project-count data-project-count-value={projects.length} data-i18n-en={`${projects.length} projects shown`} data-i18n-ja={`${projects.length}件のプロジェクトを表示`}>{projects.length} proyek ditampilkan</p>
  <div class="project-list">
    {projects.map((project, index) => (
      <article
        class={`project-card brutal-reveal project-card-${index % 2 === 0 ? "coral" : "teal"}`}
        data-project-card
        data-category={project.category}
      >
        <figure class="project-preview">
          {project.screenshots.length > 0 ? (
            <button
              class="project-preview-trigger"
              type="button"
              data-image-preview
              data-image-preview-src={project.screenshots[0].src}
              data-image-preview-alt={project.screenshots[0].alt}
              data-image-preview-alt-en={project.translations.en.screenshotAlts?.[0] ?? project.screenshots[0].alt}
              data-image-preview-alt-ja={project.translations.ja.screenshotAlts?.[0] ?? project.screenshots[0].alt}
              data-image-preview-index="0"
              aria-label={`Perbesar screenshot: ${project.screenshots[0].alt}`}
              data-i18n-aria-label-en={`Zoom screenshot: ${project.translations.en.screenshotAlts?.[0] ?? project.screenshots[0].alt}`}
              data-i18n-aria-label-ja={`スクリーンショットを拡大: ${project.translations.ja.screenshotAlts?.[0] ?? project.screenshots[0].alt}`}
              aria-haspopup="dialog"
            >
              <img
                src={project.screenshots[0].src}
                alt=""
                loading="lazy"
                decoding="async"
              />
              <span class="image-zoom-hint" aria-hidden="true" data-i18n-en="ZOOM IN ↗" data-i18n-ja="拡大 ↗">PERBESAR ↗</span>
            </button>
          ) : (
            <div class="project-preview-placeholder" role="img" aria-label={`Screenshot ${project.title} belum ditambahkan`}>
              <div class="preview-toolbar"><span></span><span></span><span></span><small>PROJECT PREVIEW</small></div>
              <div class="preview-placeholder-content">
                <span class="preview-image-icon" aria-hidden="true">▧</span>
                <strong data-i18n-en="SCREENSHOT NOT AVAILABLE" data-i18n-ja="スクリーンショットはありません">SCREENSHOT BELUM TERSEDIA</strong>
                <small data-i18n-en="Add a project capture to preview" data-i18n-ja="プレビュー用の画像を追加してください">Tambahkan capture proyek untuk preview</small>
              </div>
              <div class="preview-placeholder-footer">{project.category} / {project.stack.slice(0, 2).join(" · ")}</div>
            </div>
          )}
        </figure>
        {project.screenshots.length > 0 && (
          <template data-image-preview-set>
            {project.screenshots.map((screenshot, screenshotIndex) => (
              <img
                src={screenshot.src}
                alt={screenshot.alt}
                data-alt-en={project.translations.en.screenshotAlts?.[screenshotIndex] ?? screenshot.alt}
                data-alt-ja={project.translations.ja.screenshotAlts?.[screenshotIndex] ?? screenshot.alt}
              />
            ))}
          </template>
        )}
        <div class="project-card-number">PROJECT / {String(index + 1).padStart(2, "0")}</div>
        <div class="project-card-main">
          <div class="project-title-line">
            <h3 data-i18n-en={project.translations.en.title} data-i18n-ja={project.translations.ja.title}>{project.title}</h3>
            <span class="project-category">{project.category}</span>
          </div>
          <p class="project-role" data-i18n-en={project.translations.en.role} data-i18n-ja={project.translations.ja.role}>{project.role}</p>
          <p class="project-excerpt" data-i18n-en={project.translations.en.excerpt} data-i18n-ja={project.translations.ja.excerpt}>{project.excerpt}</p>
          <ul class="project-stack" aria-label="Teknologi yang digunakan">
            {project.stack.map((technology) => <li>{technology}</li>)}
          </ul>
        </div>
        <div class="project-actions">
          <a class="project-link" href={`/projects/${project.slug}/`}>
            <span data-i18n-en="View case study" data-i18n-ja="ケーススタディを見る">Lihat studi kasus</span><span aria-hidden="true">↗</span>
          </a>
          {project.repoUrl && (
            <a class="project-link project-repo-link" href={project.repoUrl} target="_blank" rel="noreferrer">
              <span data-i18n-en="View GitHub" data-i18n-ja="GitHubを見る">Lihat GitHub</span><span aria-hidden="true">↗</span>
            </a>
          )}
          {project.designUrl && (
            <a class="project-link project-repo-link" href={project.designUrl} target="_blank" rel="noreferrer">
              <span data-i18n-en="View design" data-i18n-ja="デザインを見る">Lihat desain</span><span aria-hidden="true">↗</span>
            </a>
          )}
          {project.demoUrl ? (
            <button
              class="project-link project-preview-link"
              type="button"
              data-project-preview-url={project.demoUrl}
              data-project-preview-title={project.title}
              data-project-preview-title-en={project.translations.en.title}
              data-project-preview-title-ja={project.translations.ja.title}
              aria-haspopup="dialog"
            >
              <span data-i18n-en="Try the app" data-i18n-ja="アプリを試す">Coba aplikasi</span><span aria-hidden="true">↗</span>
            </button>
          ) : (
            <span class="project-demo-status" data-i18n-en="LIVE PREVIEW / NOT AVAILABLE" data-i18n-ja="ライブプレビュー / 利用不可">LIVE PREVIEW / BELUM TERSEDIA</span>
          )}
        </div>
        {project.example && <span class="example-stamp" data-i18n-en="SAMPLE CONTENT" data-i18n-ja="サンプルコンテンツ">CONTOH KONTEN</span>}
      </article>
    ))}
    <p class="empty-projects" data-project-empty hidden data-i18n-en="There are no projects in this category." data-i18n-ja="このカテゴリーのプロジェクトはありません。">Belum ada proyek di kategori ini.</p>
  </div>
</div>
<dialog class="project-preview-dialog" aria-labelledby="project-preview-title" data-project-preview-dialog>
  <div class="project-preview-dialog-content">
    <header class="project-preview-dialog-header">
      <div>
        <p class="micro-label">LIVE APPLICATION PREVIEW</p>
        <h2 id="project-preview-title" data-project-preview-title data-i18n-en="App preview" data-i18n-ja="アプリのプレビュー">Preview aplikasi</h2>
      </div>
      <button class="brutal-btn preview-close" type="button" data-project-preview-close aria-label="Tutup preview" data-i18n-aria-label-en="Close preview" data-i18n-aria-label-ja="プレビューを閉じる"><span data-i18n-en="CLOSE ×" data-i18n-ja="閉じる ×">TUTUP ×</span></button>
    </header>
    <p class="project-preview-status" role="status" aria-live="polite" data-project-preview-status></p>
    <iframe
      class="project-preview-frame"
      src="about:blank"
      title="Preview aplikasi"
      data-i18n-title-en="App preview"
      data-i18n-title-ja="アプリのプレビュー"
      loading="lazy"
      referrerpolicy="no-referrer"
      data-project-preview-frame
    ></iframe>
    <footer class="project-preview-dialog-footer">
      <span data-i18n-en="If the app does not load, the destination site may prevent display in an iframe." data-i18n-ja="アプリが読み込まれない場合、リンク先サイトがiframeでの表示を制限している可能性があります。">Jika aplikasi tidak dapat dimuat, situs tujuan mungkin membatasi tampilan di dalam iframe.</span>
      <a class="project-link" href="#" target="_blank" rel="noreferrer" data-project-preview-external hidden>
        <span data-i18n-en="Open in a new tab" data-i18n-ja="新しいタブで開く">Buka di tab baru</span><span aria-hidden="true">↗</span>
      </a>
    </footer>
  </div>
</dialog>
