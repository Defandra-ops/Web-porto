---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/astro/Navbar.astro";
import MarqueeBanner from "../components/astro/MarqueeBanner.astro";
import HeroInspector from "../components/astro/HeroInspector.astro";
import ProjectFilter from "../components/astro/ProjectFilter.astro";
import CopyEmail from "../components/astro/CopyEmail.astro";
import CertificationSections from "../components/astro/CertificationSections.astro";
import { certifications } from "../data/certifications";

const projects = (await getCollection("projects"))
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .map(({ id, data }) => ({ ...data, slug: id.replace(/\.md$/, "") }));
---

<BaseLayout>
  <Navbar />
  <main>
    <section class="hero section-shell" id="top">
      <div class="hero-copy">
        <div class="availability"><span aria-hidden="true"></span> TERBUKA UNTUK PELUANG</div>
        <p class="hero-kicker">PORTOFOLIO / 2026</p>
        <h1 class="hero-title">
          <span>DEFANDRA</span>
          <span class="outline-title">RIFKY W<span class="title-period">.</span></span>
        </h1>
        <p class="hero-role">FULLSTACK ENGINEER <span>&</span> IT SUPPORT</p>
        <div class="hero-cv-card">
          <div class="hero-cv-card-top">
            <span class="micro-label">CURRICULUM VITAE</span>
            <span class="hero-cv-page-count">PDF / 02 HALAMAN</span>
          </div>
          <div class="hero-cv-card-inner">
            <button
              class="hero-cv-thumbnail"
              type="button"
              data-cv-preview-open
              aria-label="Lihat pratinjau gambar CV"
              aria-haspopup="dialog"
              aria-controls="cv-preview-dialog"
            >
              <img
                src="/images/cv/defandra-rifky-wibowo-page-1.webp"
                alt=""
                width="1013"
                height="1432"
                fetchpriority="high"
              />
            </button>
            <div class="hero-cv-copy">
              <h2>Defandra Rifky Wibowo</h2>
              <p>Fullstack Engineer &amp; IT Support</p>
            </div>
            <div class="hero-cv-actions">
              <button
                class="cv-preview-trigger"
                type="button"
                data-cv-preview-open
                aria-haspopup="dialog"
                aria-controls="cv-preview-dialog"
              >
                PREVIEW <span aria-hidden="true">↗</span>
              </button>
              <a class="brutal-btn cv-download-button" href="/cv/defandra-rifky-wibowo.pdf" download="CV-Defandra-Rifky-Wibowo.pdf">
                UNDUH <span aria-hidden="true">↓</span>
              </a>
            </div>
          </div>
        </div>
        <p class="hero-description">
          Profesional IT dengan pengalaman sebagai Fullstack Engineer dan IT Support yang berfokus pada pengembangan website, aplikasi Android, serta perancangan dan pengelolaan database secara end-to-end. Terbukti berpengalaman dalam membangun sistem internal perusahaan (seperti HRIS, Procurement, dan sistem monitoring akses berbasis RFID) menggunakan PHP, Laravel, CodeIgniter, dan MySQL. 
          Memiliki kemampuan berpikir analitis dalam memecahkan masalah teknis serta kepekaan desain visual untuk menciptakan antarmuka pengguna yang bersih, responsif, dan ramah pengguna.
        </p>
        <div class="hero-actions">
          <a class="brutal-btn button-primary" href="#projects">JELAJAHI PROYEK <span aria-hidden="true">↓</span></a>
          <a class="text-link" href="https://github.com/Defandra-ops" target="_blank" rel="noreferrer">
            GITHUB <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="hero-meta">
          <span>BERBASIS DI INDONESIA</span><span class="meta-divider"></span><span>BUILDING WITH PURPOSE</span>
        </div>
      </div>
      <div class="hero-visual">
        <span class="visual-cross cross-one" aria-hidden="true">✳</span>
        <span class="visual-cross cross-two" aria-hidden="true">+</span>
        <figure class="hero-portrait brutal-reveal">
          <img
            src="/images/defandra-rifky.png"
            alt="Defandra Rifky berdiri di area publik pada malam hari"
            width="768"
            height="1152"
            fetchpriority="high"
          />
          <figcaption><span>DEFANDRA RIFKY W.</span><span>FULLSTACK ENGINEER / IT SUPPORT</span></figcaption>
        </figure>
        <HeroInspector />
        <div class="visual-caption"><span>FIG. 01</span> MULTI-DISCIPLINARY BY DESIGN</div>
      </div>
      <span class="hero-edge-label" aria-hidden="true">SCROLL TO EXPLORE ↓</span>
    </section>

    <MarqueeBanner />

    <section class="section-shell projects-section section-pad" id="projects">
      <div class="section-heading">
        <div>
          <p class="section-index">01 — SELECTED WORKS</p>
          <h2>Proyek yang<br /><span class="outline-title">punya tujuan.</span></h2>
        </div>
        <p class="section-intro">
          Kumpulan studi kasus yang menunjukkan cara saya merancang, membangun, dan
          menyelesaikan masalah — bukan sekadar daftar teknologi.
        </p>
      </div>
      <ProjectFilter projects={projects} />
    </section>

    <MarqueeBanner items={["Vue.js", "Astro", "API Design", "Troubleshooting", "Deployment"]} label="Keahlian" />

    <section class="section-shell capabilities-section section-pad" id="skills">
      <div class="section-heading">
        <div>
          <p class="section-index">02 — TECHNICAL CAPABILITIES</p>
          <h2>Tools are great.<br /><span class="outline-title">Outcomes matter.</span></h2>
        </div>
        <p class="section-intro">
          Memadukan pola pikir engineering dan ketelitian dukungan teknis untuk membuat
          sistem yang bekerja baik bagi orang yang menggunakannya.
        </p>
      </div>
      <div class="capabilities-grid">
        <article class="capability-block capability-coral">
          <div class="capability-number">01</div>
          <p class="micro-label">BUILD THE EXPERIENCE</p>
          <h3>Frontend<br />Engineering</h3>
          <p>Antarmuka yang responsif, aksesibel, dan disusun dari komponen yang mudah dikembangkan.</p>
          <ul><li>Vue.js</li><li>Astro</li><li>Tailwind CSS</li><li>JavaScript / TypeScript</li></ul>
        </article>
        <article class="capability-block capability-teal">
          <div class="capability-number">02</div>
          <p class="micro-label">CONNECT THE SYSTEM</p>
          <h3>Backend<br />& Data</h3>
          <p>Fondasi API dan integrasi data yang konsisten, mudah dipahami, dan siap diuji.</p>
          <ul><li>REST API</li><li>Database design</li><li>Authentication</li><li>Integrasi layanan</li></ul>
        </article>
        <article class="capability-block capability-yellow">
          <div class="capability-number">03</div>
          <p class="micro-label">KEEP IT RUNNING</p>
          <h3>IT Support<br />& Infra</h3>
          <p>Diagnosis masalah secara sistematis, dukungan pengguna, dan perhatian pada reliabilitas.</p>
          <ul><li>Troubleshooting</li><li>Networking</li><li>Deployment</li><li>Dokumentasi teknis</li></ul>
        </article>
      </div>
    </section>

    <section class="experience-section" id="experience">
      <div class="section-shell section-pad experience-inner">
        <div class="section-heading">
          <div>
            <p class="section-index">03 — EXPERIENCE & EDUCATION</p>
            <h2>Always learning.<br /><span class="outline-title">Always building.</span></h2>
          </div>
          <p class="section-intro">
            Pengalaman dan pendidikan menjadi fondasi cara saya memahami masalah dan
            bekerja bersama tim.
          </p>
        </div>
        <div class="timeline">
          <article class="timeline-row">
            <span class="timeline-date">PENGALAMAN</span>
            <div class="timeline-marker" aria-hidden="true"></div>
            <div class="timeline-copy">
              <!-- <span class="example-stamp">LENGKAPI DETAIL</span> -->
              <h3>Fullstack Web Developer</h3>
              <p>Web Developer · PT Dian Ikrar Perkasa · 2025 - 2026</p>
              <small>- Mengembangkan sistem web monitoring akses pintu apartemen berbasis teknologi kartu RFID.</small> 
              <small>- Membangun aplikasi pencatatan daftar hadir otomatis untuk rapat tahunan apartemen menggunakan scan barcode.</small>
              <small>- Memodernisasi serta memperbarui arsitektur aplikasi procurement dan HRIS lama menjadi lebih bersih dan responsif.</small>
              <small>- Menyesuaikan dan mengoptimalkan fitur-fitur aplikasi berdasarkan feedback pengguna secara berkelanjutan.</small>
              
            </div>
          </article>
          <article class="timeline-row">
            <span class="timeline-date">PENDIDIKAN</span>
            <div class="timeline-marker" aria-hidden="true"></div>
            <div class="timeline-copy">
              <!-- <span class="example-stamp">LENGKAPI DETAIL</span> -->
              <h3>Teknik Informatika</h3>
              <p>Universitas Serang Raya · 2020 - 2024</p>
              <small>IPK 3.60/4.00</small>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="section-shell certifications-section section-pad" id="certifications">
      <div class="section-heading">
        <div>
          <p class="section-index">04 — CERTIFICATIONS & CREDENTIALS</p>
          <h2>Belajar terus.<br /><span class="outline-title">Berkembang nyata.</span></h2>
        </div>
        <p class="section-intro">
          Sertifikasi dan kredensial profesional yang mendukung perjalanan saya di bidang teknologi.
        </p>
      </div>
      <CertificationSections certifications={certifications} categoryHeadingLevel={3} />
      <a class="project-link certifications-all-link" href="/certifications/">
        <span>Lihat semua sertifikasi</span><span aria-hidden="true">↗</span>
      </a>
    </section>

    <section class="contact-section section-shell section-pad" id="contact">
      <div class="contact-copy">
        <p class="section-index">05 — LET’S TALK</p>
        <h2>Have a good<br /><span class="outline-title">problem?</span></h2>
        <p>Saya terbuka untuk berdiskusi tentang kolaborasi, peluang kerja, atau ide yang perlu diwujudkan.</p>
        <CopyEmail />
        <nav class="contact-social-links" aria-label="Profil media sosial">
          <a class="text-link" href="https://www.linkedin.com/in/defandra-rifky-526309333/" target="_blank" rel="noopener noreferrer">
            LINKEDIN <span aria-hidden="true">↗</span>
          </a>
          <a class="text-link" href="https://www.instagram.com/defandrarifky7/" target="_blank" rel="noopener noreferrer">
            INSTAGRAM <span aria-hidden="true">↗</span>
          </a>
          <a class="text-link" href="https://www.threads.com/@defandrarifky7" target="_blank" rel="noopener noreferrer">
            THREADS <span aria-hidden="true">↗</span>
          </a>
        </nav>
      </div>
      <div class="contact-card">
        <span class="contact-card-index">OPEN CHANNEL / 01</span>
        <div class="contact-symbol" aria-hidden="true">↗</div>
        <h3>Let’s make<br />something useful.</h3>
        <a
          href="https://mail.google.com/mail/?view=cm&amp;fs=1&amp;to=defandrarifky%40gmail.com"
          target="_blank"
          rel="noopener noreferrer"
        >
          KIRIM EMAIL <span aria-hidden="true">↗</span>
        </a>
        <span class="contact-card-foot">GITHUB / DEFANDRA-OPS</span>
      </div>
    </section>
    <dialog class="cv-dialog" id="cv-preview-dialog" aria-labelledby="cv-dialog-title" data-cv-dialog>
      <div class="cv-dialog-content">
        <header class="cv-dialog-header">
          <div>
            <p class="micro-label">CURRICULUM VITAE / PREVIEW</p>
            <h2 id="cv-dialog-title">Defandra Rifky Wibowo</h2>
          </div>
          <button class="brutal-btn cv-dialog-close" type="button" data-cv-dialog-close aria-label="Tutup pratinjau CV">
            TUTUP ×
          </button>
        </header>
        <div class="cv-image-preview-pages">
          <figure>
            <img
              data-src="/images/cv/defandra-rifky-wibowo-page-1.webp"
              alt="CV Defandra Rifky Wibowo, halaman 1 dari 2"
              width="1013"
              height="1432"
              data-cv-preview-image
            />
            <figcaption>HALAMAN 01 / 02</figcaption>
          </figure>
          <figure>
            <img
              data-src="/images/cv/defandra-rifky-wibowo-page-2.webp"
              alt="CV Defandra Rifky Wibowo, halaman 2 dari 2"
              width="1013"
              height="1432"
              data-cv-preview-image
            />
            <figcaption>HALAMAN 02 / 02</figcaption>
          </figure>
        </div>
        <footer class="cv-dialog-footer">
          <span>PDF / 02 HALAMAN</span>
          <a class="brutal-btn cv-download-button" href="/cv/defandra-rifky-wibowo.pdf" download="CV-Defandra-Rifky-Wibowo.pdf">
            UNDUH CV <span aria-hidden="true">↓</span>
          </a>
        </footer>
      </div>
    </dialog>
  </main>
  <footer class="site-footer">
    <div class="section-shell footer-inner">
      <a class="wordmark" href="#top"><span class="wordmark-mark">DR</span><span>DEFANDRA RIFKY<span class="wordmark-dot">.</span></span></a>
      <p>DESIGNED TO BE USEFUL. BUILT WITH INTENT.</p>
      <a href="https://github.com/Defandra-ops" target="_blank" rel="noreferrer">GITHUB ↗</a>
      <a href="/#certifications">SERTIFIKASI ↗</a>
      <span>© {new Date().getFullYear()} DEFANDRA RIFKY</span>
    </div>
  </footer>
</BaseLayout>
