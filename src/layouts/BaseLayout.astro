---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

interface Props {
  title?: string;
  titleEn?: string;
  titleJa?: string;
  description?: string;
  descriptionEn?: string;
  descriptionJa?: string;
}

const {
  title = "Defandra Rifky W. — Fullstack Engineer & IT Support",
  titleEn = "Defandra Rifky W. — Fullstack Engineer & IT Support",
  titleJa = "Defandra Rifky W. — フルスタックエンジニア・ITサポート",
  description = "Portofolio Defandra Rifky, Fullstack Engineer & IT Support. Menjelajahi antarmuka, sistem, dan infrastruktur dengan pendekatan praktis.",
  descriptionEn = "Portfolio of Defandra Rifky, Fullstack Engineer & IT Support. Exploring interfaces, systems, and infrastructure with a practical approach.",
  descriptionJa = "フルスタックエンジニア兼ITサポート、Defandra Rifkyのポートフォリオ。実践的なアプローチでインターフェース、システム、インフラを探求します。",
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} data-i18n-content-en={descriptionEn} data-i18n-content-ja={descriptionJa} />
    <meta name="theme-color" content="#faf9f6" />
    <title data-i18n-en={titleEn} data-i18n-ja={titleJa}>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <slot />
    <dialog class="image-lightbox" aria-label="Pratinjau gambar" data-i18n-aria-label-en="Image preview" data-i18n-aria-label-ja="画像プレビュー" data-image-lightbox>
      <div class="image-lightbox-content">
        <div class="image-lightbox-toolbar">
          <p class="micro-label" data-image-lightbox-caption>SCREENSHOT PREVIEW</p>
          <button class="brutal-btn preview-close" type="button" data-image-lightbox-close aria-label="Tutup pratinjau gambar" data-i18n-aria-label-en="Close image preview" data-i18n-aria-label-ja="画像プレビューを閉じる">
            <span data-i18n-en="CLOSE ×" data-i18n-ja="閉じる ×">TUTUP ×</span>
          </button>
        </div>
        <img class="image-lightbox-image" src="" alt="" data-image-lightbox-image />
        <div class="image-lightbox-controls">
          <button class="brutal-btn image-lightbox-nav" type="button" data-image-lightbox-previous aria-label="Lihat screenshot sebelumnya" data-i18n-aria-label-en="View previous screenshot" data-i18n-aria-label-ja="前のスクリーンショットを見る">
            <span data-i18n-en="← PREVIOUS" data-i18n-ja="← 前へ">← SEBELUMNYA</span>
          </button>
          <span class="image-lightbox-count" aria-live="polite" data-image-lightbox-count></span>
          <button class="brutal-btn image-lightbox-nav" type="button" data-image-lightbox-next aria-label="Lihat screenshot berikutnya" data-i18n-aria-label-en="View next screenshot" data-i18n-aria-label-ja="次のスクリーンショットを見る">
            <span data-i18n-en="NEXT →" data-i18n-ja="次へ →">BERIKUTNYA →</span>
          </button>
        </div>
      </div>
    </dialog>
    <script>
      import "../scripts/motion.ts";
      import "../scripts/interactions.ts";
      import "../scripts/i18n.ts";
    </script>
  </body>
</html>
